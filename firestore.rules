rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Resolves the caller's own publicId from their private user doc — never trusts a
    // client-supplied publicId for permission checks.
    function myPublicId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.publicId;
    }

    // Deterministic id for the (unordered) pair of two publicIds — used as the document
    // id for a chat request, so there can only ever be one *live* request between any two
    // accounts at a time. Chat rooms are NOT keyed this way (see chatRooms below) so that
    // ending one conversation never blocks a later, brand-new session between the same pair.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // --- Shared helpers for the analyticsDaily / analyticsActivityDaily aggregate-only
    // counters below. Firestore rules can't loop over a dynamic field list, so every legal
    // write is enumerated explicitly as an exact one- or two-field delta, mirroring the
    // rest of this file's style (e.g. the users/{uid} totalPoints delta checks above)
    // rather than a generic loop.
    //
    // IMPORTANT: `request.resource.data.diff(resource.data).affectedKeys()` is computed
    // exactly ONCE per write, at the single call site in each match block below
    // (`isValidAnalyticsDailyDelta(analyticsAffectedKeys())` etc.), and threaded through
    // every branch as the `keys` parameter — an earlier version called the equivalent of
    // this inside each of the ~9 OR-ed branches individually (9 separate `.diff()` calls
    // for one write) and reliably hit Firestore's "maximum of 1000 expressions to
    // evaluate" per-request budget, even on a write that should short-circuit on the very
    // first branch. `.diff()` is evidently expensive enough that this fan-out mattered;
    // computing it once and passing the result through fixed it.
    //
    // The prior value of one field — 0 when the document doesn't exist yet (create) or the
    // field was never set before.
    function priorNum(field) {
      return resource != null ? resource.data.get(field, 0) : 0;
    }
    // The set of field names this write actually changes — on create, that's just the new
    // document's own keys; on update, the real diff against the existing document. Compute
    // this ONCE per write and pass its result into every helper below as `keys`.
    function analyticsAffectedKeys() {
      return resource != null
        ? request.resource.data.diff(resource.data).affectedKeys()
        : request.resource.data.keys();
    }
    // A write that touches ONLY `field` (per the precomputed `keys`), moving it by exactly
    // `delta`, never negative.
    function isSingleFieldDelta(keys, field, delta) {
      return keys.hasOnly([field])
        && request.resource.data.get(field, 0) - priorNum(field) == delta
        && request.resource.data.get(field, 0) >= 0;
    }
    // A write that touches ONLY `fieldA` and `fieldB` together, each by its own exact
    // delta — used for "one mission + one Garden visit" below, never negative on either side.
    function isTwoFieldDelta(keys, fieldA, deltaA, fieldB, deltaB) {
      return keys.hasOnly([fieldA, fieldB])
        && request.resource.data.get(fieldA, 0) - priorNum(fieldA) == deltaA
        && request.resource.data.get(fieldB, 0) - priorNum(fieldB) == deltaB
        && request.resource.data.get(fieldA, 0) >= 0
        && request.resource.data.get(fieldB, 0) >= 0;
    }

    // Mood-category delta helper — computed once per field rather than enumerated as
    // ordered from/to pairs (an earlier version enumerated all 20 such pairs explicitly,
    // which contributed to the same evaluation-budget problem described above).
    function moodDelta(field) {
      return request.resource.data.get(field, 0) - priorNum(field);
    }
    // First daily mood check-in: moodCheckins +1 and exactly one category +1 (the other
    // four untouched), every category value non-negative.
    function isFirstMoodCheckin(keys) {
      return keys.hasOnly(['moodCheckins', 'moodHappy', 'moodCalm', 'moodListen', 'moodTired', 'moodReadyToListen'])
        && moodDelta('moodCheckins') == 1
        && moodDelta('moodHappy') in [-1, 0, 1] && moodDelta('moodCalm') in [-1, 0, 1]
        && moodDelta('moodListen') in [-1, 0, 1] && moodDelta('moodTired') in [-1, 0, 1]
        && moodDelta('moodReadyToListen') in [-1, 0, 1]
        && request.resource.data.get('moodHappy', 0) >= 0 && request.resource.data.get('moodCalm', 0) >= 0
        && request.resource.data.get('moodListen', 0) >= 0 && request.resource.data.get('moodTired', 0) >= 0
        && request.resource.data.get('moodReadyToListen', 0) >= 0
        && moodDelta('moodHappy') + moodDelta('moodCalm') + moodDelta('moodListen')
             + moodDelta('moodTired') + moodDelta('moodReadyToListen') == 1;
    }
    // A same-day mood re-categorization: one category -1, a different one +1, moodCheckins
    // untouched, every category value non-negative.
    function isMoodRecategorize(keys) {
      return keys.hasOnly(['moodCheckins', 'moodHappy', 'moodCalm', 'moodListen', 'moodTired', 'moodReadyToListen'])
        && moodDelta('moodCheckins') == 0
        && moodDelta('moodHappy') in [-1, 0, 1] && moodDelta('moodCalm') in [-1, 0, 1]
        && moodDelta('moodListen') in [-1, 0, 1] && moodDelta('moodTired') in [-1, 0, 1]
        && moodDelta('moodReadyToListen') in [-1, 0, 1]
        && request.resource.data.get('moodHappy', 0) >= 0 && request.resource.data.get('moodCalm', 0) >= 0
        && request.resource.data.get('moodListen', 0) >= 0 && request.resource.data.get('moodTired', 0) >= 0
        && request.resource.data.get('moodReadyToListen', 0) >= 0
        && moodDelta('moodHappy') + moodDelta('moodCalm') + moodDelta('moodListen')
             + moodDelta('moodTired') + moodDelta('moodReadyToListen') == 0
        && (moodDelta('moodHappy') == -1 || moodDelta('moodCalm') == -1 || moodDelta('moodListen') == -1
            || moodDelta('moodTired') == -1 || moodDelta('moodReadyToListen') == -1);
    }
    // The full analyticsDaily disjunction, taking the precomputed affected-keys set once.
    function isValidAnalyticsDailyDelta(keys) {
      return isSingleFieldDelta(keys, 'dailyActiveUsers', 1) ||
        isSingleFieldDelta(keys, 'newUsers', 1) ||
        isSingleFieldDelta(keys, 'chatSessionsStarted', 1) ||
        isSingleFieldDelta(keys, 'chatSessionsEnded', 1) ||
        isSingleFieldDelta(keys, 'safetyBlocks', 1) ||
        isSingleFieldDelta(keys, 'missionsCompleted', 1) ||
        isTwoFieldDelta(keys, 'missionsCompleted', 1, 'gardenVisits', 1) ||
        isFirstMoodCheckin(keys) ||
        isMoodRecategorize(keys);
    }
    // The full analyticsActivityDaily disjunction, taking the precomputed affected-keys set once.
    // Send a Song was removed from the app (nothing writes 'sendSong' anymore), so that key
    // is deliberately no longer accepted here — this only blocks a NEW write of that shape;
    // historical analyticsActivityDaily documents with an existing sendSong field are
    // untouched (read is unaffected, and the offline export script uses the Admin SDK, which
    // bypasses these rules entirely).
    function isValidAnalyticsActivityDelta(keys) {
      return isSingleFieldDelta(keys, 'sayItToday', 1) ||
        isSingleFieldDelta(keys, 'hearSomeone', 1) || isSingleFieldDelta(keys, 'friendBond', 1) ||
        isSingleFieldDelta(keys, 'whoAmI', 1) || isSingleFieldDelta(keys, 'echoJournal', 1) ||
        isSingleFieldDelta(keys, 'drawListen', 1) || isSingleFieldDelta(keys, 'garden', 1);
    }

    // Private per-user document (codename, avatarId, mood, onboarding state, completed
    // activities, the publicId pointer, and the ECHO Points summary cache — totalPoints/
    // currentStreak/bestStreak/lastCheckinDate). Only the owning account may ever read or
    // write it. Email is intentionally never stored here — Firebase Auth already owns it —
    // so it can never leak through this collection even if a rule were misconfigured.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Registration writes the whole doc in one shot (see createUserDoc) — no field
      // restrictions needed here, same as the create rule's original unrestricted intent.
      allow create: if request.auth != null && request.auth.uid == uid;

      // Every existing free-form field (codename, avatarId, mood, onboardingComplete,
      // completedActivityIds, moodUpdatedAt, publicId, ...) may still change freely by the
      // owner exactly as before — UNLESS this write touches the points/streak cache, in
      // which case it must be a plausible single reward, not an arbitrary value. The
      // rewards ledger below (users/{uid}/rewards/{type}_{date}, immutable + create-once)
      // is what actually makes a duplicate/farmed reward impossible; this is a lightweight
      // second guard against a client just writing this cache field directly.
      allow update: if request.auth != null && request.auth.uid == uid && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['totalPoints', 'currentStreak', 'bestStreak', 'lastCheckinDate'])
        ||
        (
          // A non-checkin daily mission: only totalPoints moves, by exactly one valid
          // reward amount (5 or 10 — the only two point values in the mission catalog).
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['currentStreak', 'bestStreak', 'lastCheckinDate'])
          && request.resource.data.totalPoints is number
          && (request.resource.data.totalPoints - resource.data.get('totalPoints', 0) == 5
              || request.resource.data.totalPoints - resource.data.get('totalPoints', 0) == 10)
        )
        ||
        (
          // The daily check-in specifically: +5 points, and lastCheckinDate must actually
          // advance to a day not already recorded — blocks replaying today's streak bump.
          request.resource.data.totalPoints is number
          && request.resource.data.totalPoints - resource.data.get('totalPoints', 0) == 5
          && request.resource.data.lastCheckinDate is string
          && request.resource.data.lastCheckinDate != resource.data.get('lastCheckinDate', '')
          && request.resource.data.currentStreak is number
          && request.resource.data.bestStreak is number
          && request.resource.data.bestStreak >= request.resource.data.currentStreak
        )
      );

      allow delete: if false;

      // Per-day mission/points breakdown — powers the Me tab's daily checklist, weekly
      // view, and history. Never deleted (spec: "do not delete old progress"). This
      // document is NOT itself what prevents duplicate rewards (the rewards ledger below
      // is), so it only needs owner-scoping and basic shape validation.
      match /dailyProgress/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.pointsEarned is number
          && request.resource.data.missionsCompleted is list
          && request.resource.data.checkinCompleted is bool;
        allow delete: if false;
      }

      // The authoritative, append-only reward ledger — THIS is what actually prevents a
      // mission reward from ever being granted twice. The document id is
      // {missionType}_{YYYY-MM-DD}, so Firestore's own create-only-if-absent semantics
      // make a second award for the same person/day/type structurally impossible, from
      // any device, any number of refreshes/tabs, regardless of client-side state.
      match /rewards/{rewardId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.type in
            ['checkin', 'garden', 'journal', 'friendbond', 'kindword', 'hearwithheart']
          && request.resource.data.date is string
          && rewardId == request.resource.data.type + '_' + request.resource.data.date
          && (
            (request.resource.data.type in ['journal', 'friendbond', 'hearwithheart']
              && request.resource.data.points == 10)
            || (request.resource.data.type in ['checkin', 'garden', 'kindword']
              && request.resource.data.points == 5)
          );
        allow update, delete: if false;
      }
    }

    // Public-facing profile (codename, avatarId, mood only) keyed by a random publicId
    // that is NOT the Firebase uid — see users/{uid}.publicId. Any signed-in student may
    // read these (needed for Echo Space / online-members display); a profile may only be
    // written by the account whose private doc claims that publicId.
    match /publicProfiles/{publicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.publicId == publicId;
    }

    // A pending/accepted/declined/cancelled/expired "may we chat privately" request
    // between two accounts, keyed by pairId(fromPublicId, toPublicId) so at most one live
    // request can exist between any two people. Sender/receiver codename+avatar+mood are
    // denormalized in at send-time purely for display — never the uid or email. `roomId`
    // points at the CURRENT/latest chatRooms session (see below); once that room is ended
    // this doc is flipped to 'expired' so the same pair can start a fresh session later.
    match /chatRequests/{requestId} {
      // `resource == null` (the document doesn't exist yet) is allowed through so a
      // client can safely probe "does a request already exist for this pair" before ever
      // writing — sendRequest does exactly this to decide create vs. reopen vs. duplicate
      // without guessing from a denied write. This leaks nothing: a nonexistent doc has no
      // data, and the id is only derivable from two people's publicIds, which any signed-in
      // student can already resolve via publicProfiles. An EXISTING request's data is still
      // readable only by its two participants, exactly as before.
      allow read: if isSignedIn()
        && (resource == null || myPublicId() == resource.data.fromPublicId || myPublicId() == resource.data.toPublicId);

      // First-ever request between this pair.
      allow create: if isSignedIn()
        && request.resource.data.fromPublicId == myPublicId()
        && request.resource.data.toPublicId != myPublicId()
        && requestId == pairId(request.resource.data.fromPublicId, request.resource.data.toPublicId)
        && request.resource.data.status == 'pending'
        && request.resource.data.roomId == null;

      allow update: if isSignedIn() && (
        // Receiver accepts or declines a pending request. On accept, roomId must point at
        // a freshly created, still-active room (verified independently by chatRooms'
        // own create rule below) — its exact value isn't re-derivable here since chat
        // rooms use unique per-session ids, not a value computable from this document.
        // respondedAt records exactly when the receiver acted, separate from updatedAt.
        (myPublicId() == resource.data.toPublicId
          && resource.data.status == 'pending'
          && request.resource.data.fromPublicId == resource.data.fromPublicId
          && request.resource.data.toPublicId == resource.data.toPublicId
          && request.resource.data.respondedAt == request.time
          && (
            (request.resource.data.status == 'declined' && request.resource.data.roomId == null)
            || (request.resource.data.status == 'accepted' && request.resource.data.roomId is string)
          ))
        ||
        // A `pending` request that has sat unanswered past the expiry window may be
        // replaced by a fresh pending request in one step, by either former participant —
        // production had 21-hour-old pending requests permanently denying a new request
        // between the same pair ("Missing or insufficient permissions."), because no other
        // branch here ever let a still-`pending` document change. The 60-minute window
        // must match PENDING_EXPIRY_MS in src/features/chat/chatRequestState.ts. Falls back
        // to updatedAt for a legacy document that predates createdAt being stored — using
        // .get(key, default) rather than resource.data.createdAt directly, since accessing
        // a genuinely-missing map key throws an evaluation error instead of just being falsy.
        (resource.data.status == 'pending'
          && (myPublicId() == resource.data.fromPublicId || myPublicId() == resource.data.toPublicId)
          && request.resource.data.fromPublicId == myPublicId()
          && request.resource.data.toPublicId != myPublicId()
          && (request.resource.data.toPublicId == resource.data.fromPublicId
              || request.resource.data.toPublicId == resource.data.toPublicId)
          && request.resource.data.status == 'pending'
          && request.resource.data.roomId == null
          && (
            (resource.data.get('createdAt', null) is timestamp
              && request.time > resource.data.get('createdAt', null) + duration.value(60, 'm'))
            || (!(resource.data.get('createdAt', null) is timestamp)
                && resource.data.get('updatedAt', null) is timestamp
                && request.time > resource.data.get('updatedAt', null) + duration.value(60, 'm'))
          ))
        ||
        // Sender cancels their own still-pending request.
        (myPublicId() == resource.data.fromPublicId
          && resource.data.status == 'pending'
          && request.resource.data.fromPublicId == resource.data.fromPublicId
          && request.resource.data.toPublicId == resource.data.toPublicId
          && request.resource.data.status == 'cancelled'
          && request.resource.data.roomId == null)
        ||
        // Either participant ends their active room (see chatRooms update below, written
        // in the SAME batch) — this flips the owning request to 'expired' so a fresh
        // request/session between the same two people can be started later. roomId is
        // left untouched, preserving the link to the now-ended room's history.
        (resource.data.status == 'accepted'
          && (myPublicId() == resource.data.fromPublicId || myPublicId() == resource.data.toPublicId)
          && request.resource.data.fromPublicId == resource.data.fromPublicId
          && request.resource.data.toPublicId == resource.data.toPublicId
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.status == 'expired'
          && get(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)).data.status == 'active')
        ||
        // Either former party re-opens a finished request as a fresh pending one.
        (resource.data.status in ['declined', 'cancelled', 'expired']
          && (myPublicId() == resource.data.fromPublicId || myPublicId() == resource.data.toPublicId)
          && request.resource.data.fromPublicId == myPublicId()
          && request.resource.data.toPublicId != myPublicId()
          && (request.resource.data.toPublicId == resource.data.fromPublicId
              || request.resource.data.toPublicId == resource.data.toPublicId)
          && request.resource.data.status == 'pending'
          && request.resource.data.roomId == null)
      );

      allow delete: if false;
    }

    // A private 1:1 chat room / conversation session. Ids are unique per session (NOT the
    // pairId) so that ending one conversation never blocks the same two people from later
    // starting a brand-new one — old ended rooms are simply left in place, still readable
    // by their two participants, rather than reused or deleted. Only the two participants
    // may ever read it, its messages, or end it; nobody may write into a room they are not
    // part of, and nobody may ever revive an ended room back to active.
    match /chatRooms/{roomId} {
      allow read: if isSignedIn() && resource != null && myPublicId() in resource.data.participants;

      // Created only as part of the same batch that accepts its request (see
      // acceptRequest in privateChatBridge.ts) — requestId (not this doc's own id) is
      // what ties it back to a real, currently-pending request the caller is the
      // receiver of.
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && myPublicId() in request.resource.data.participants
        && request.resource.data.requestId == pairId(request.resource.data.participants[0], request.resource.data.participants[1])
        && request.resource.data.status == 'active'
        && request.resource.data.endedAt == null
        && request.resource.data.endedBy == null
        && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.status == 'pending'
        && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.toPublicId == myPublicId();

      // The only update ever allowed: an active room's two participants, and only they,
      // may end it — one-directional (active -> ended); an ended room can never be
      // reactivated, and no other field may change.
      allow update: if isSignedIn()
        && resource != null
        && resource.data.status == 'active'
        && myPublicId() in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'endedBy'])
        && request.resource.data.status == 'ended'
        && request.resource.data.endedBy == myPublicId()
        && request.resource.data.endedAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;

        // Ended rooms reject new messages outright. Two shapes: an ordinary text message
        // (kind omitted, exactly as before stickers existed — backward compatible with
        // every message ever written) or a sticker message, whose only content is an id
        // from the fixed, app-controlled ECHO_STICKERS catalog (see src/data/stickers.ts)
        // — never arbitrary text/HTML.
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/chatRooms/$(roomId)).data.status == 'active'
          && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && request.resource.data.senderPublicId == myPublicId()
          && (
            (request.resource.data.get('kind', 'text') == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.get('kind', 'text') == 'sticker'
              && request.resource.data.stickerId is string
              && request.resource.data.stickerId.size() > 0
              && request.resource.data.stickerId.size() <= 60)
          );

        allow update, delete: if false;
      }

      // Realtime "read" cursor for private-chat read receipts ("อ่านแล้ว") — one document
      // per participant, holding ONLY a server timestamp of when THEY last had this room
      // open and visible. Never message content, never who-read-what beyond "as of this
      // server time, this participant has seen everything up to here" — the client derives
      // "read" purely by comparing this timestamp against a message's own createdAt, so no
      // per-message read flag is ever written (see privateChatBridge.ts markRoomRead).
      //
      // Security: the document id IS the owning participant's own publicId, so a sender can
      // never forge the recipient's read status — myPublicId() (resolved server-side from
      // the caller's own uid, never client-supplied) can only ever equal {publicId} for the
      // account that publicId actually belongs to. Gated to the room's own participants and
      // to an `active` room only, so the read cursor can never be created for a room the
      // caller isn't part of, and freezes automatically the moment the room ends (satisfies
      // "preserve the final read state after conversation ends" as a rule, not just a UI
      // convention) — this can never reactivate an ended room, send a message, or touch any
      // other room field; it is a fully separate document.
      match /readState/{publicId} {
        allow read: if isSignedIn()
          && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;

        allow create: if isSignedIn()
          && myPublicId() == publicId
          && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && get(/databases/$(database)/documents/chatRooms/$(roomId)).data.status == 'active'
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;

        allow update: if isSignedIn()
          && myPublicId() == publicId
          && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && get(/databases/$(database)/documents/chatRooms/$(roomId)).data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;

        allow delete: if false;
      }
    }

    // A notification for the Notification Center bell, owned by ownerPublicId (only they
    // may ever read or mark it read) and describing something another account did —
    // fromPublicId/fromCodename/fromAvatarId denormalized for display, never uid/email.
    // Creation is tied directly to the chat workflow, not freely writable:
    //  - incoming_chat_request is written by the sender right after their chatRequests
    //    create succeeds (see sendRequest in privateChatBridge.ts) — a get() cannot see a
    //    sibling write's not-yet-committed state for a brand new pair, so this is a
    //    second, best-effort write rather than part of that same batch.
    //  - chat_request_accepted / chat_request_declined are written by the receiver as
    //    part of the SAME batch that flips the chatRequests doc to accepted/declined, so
    //    get() below still sees its pre-batch 'pending' state, mirroring how chatRooms
    //    creation is gated.
    //  - new_message is written by the sender right after their message send succeeds,
    //    addressed to the other room participant — verified against the real room, not
    //    against chatRequests (a room may outlive its originating request's own status).
    // Nobody may fabricate a notification's unread state on someone else's behalf: only
    // the notification's own owner may ever flip `read`, and only to true.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource != null && myPublicId() == resource.data.ownerPublicId;

      // The owner may only ever flip their own notification's `read` flag — nothing else.
      allow update: if isSignedIn() && resource != null
        && myPublicId() == resource.data.ownerPublicId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;

      // Notification Center housekeeping only — the owner may delete their own notification
      // row at any time. This can NEVER touch chatRequests or chatRooms (Firestore security
      // rules cannot cascade to other documents/collections), so deleting a notification —
      // including an incoming_chat_request one — never changes a request's real status; the
      // student can still accept/decline a still-pending request from the Chat Requests page,
      // which reads chatRequests directly and was never driven by this collection.
      allow delete: if isSignedIn() && resource != null && myPublicId() == resource.data.ownerPublicId;

      allow create: if isSignedIn()
        && request.resource.data.fromPublicId == myPublicId()
        && request.resource.data.ownerPublicId != myPublicId()
        && request.resource.data.read == false
        && request.resource.data.fromCodename is string
        && (
          (request.resource.data.type == 'incoming_chat_request'
            && request.resource.data.roomId == null
            && request.resource.data.requestId == pairId(request.resource.data.fromPublicId, request.resource.data.ownerPublicId)
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.status == 'pending'
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.fromPublicId == myPublicId()
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.toPublicId == request.resource.data.ownerPublicId)
          ||
          (request.resource.data.type == 'chat_request_accepted'
            && request.resource.data.roomId is string
            && request.resource.data.requestId == pairId(request.resource.data.fromPublicId, request.resource.data.ownerPublicId)
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.status == 'pending'
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.toPublicId == myPublicId()
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.fromPublicId == request.resource.data.ownerPublicId)
          ||
          (request.resource.data.type == 'chat_request_declined'
            && request.resource.data.roomId == null
            && request.resource.data.requestId == pairId(request.resource.data.fromPublicId, request.resource.data.ownerPublicId)
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.status == 'pending'
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.toPublicId == myPublicId()
            && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.fromPublicId == request.resource.data.ownerPublicId)
          ||
          (request.resource.data.type == 'new_message'
            && request.resource.data.roomId is string
            && get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.status == 'active'
            && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.participants
            && request.resource.data.ownerPublicId in get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.participants)
        );
    }

    // --- Privacy-safe, aggregate-only usage statistics for the Google Sheets dashboard
    // (see src/features/analytics/analyticsService.ts). Firebase remains the source of
    // truth; these documents hold ONLY bare counters or private per-account idempotency
    // markers — never message/journal/reflection text, never a codename/publicId/email,
    // and the raw uid appears only as a path segment on a marker nobody (student or
    // otherwise) can ever read back through these rules. Nobody may ever READ these from a
    // normal client — the only reader is the offline admin export script
    // (scripts/exportStatsToSheets.ts), which uses the Firebase Admin SDK and bypasses
    // these rules entirely, so there is no client-side "admin" path to misconfigure.
    //
    // WRITE SECURITY NOTE: each write below is constrained to a specific, small, always-
    // non-negative delta on an explicit allowlist of fields — the same class of guarantee
    // this file's own users/{uid}.totalPoints rule already relies on (see above). Firestore
    // rules cannot verify that a shared counter's increment was written in the SAME
    // transaction as a genuine, real underlying event (rules only ever see each document's
    // own before/after state, never a sibling write's success within the same commit) — so
    // a determined attacker hand-crafting raw Firestore SDK calls (bypassing this app's own
    // UI entirely) could, at most, inflate a shared counter by repeatedly satisfying its
    // narrow precondition, never set it to an arbitrary value, never read anyone else's
    // data, and never affect a real chat/mission/notification/room document. Given the
    // actual stakes here (an internal usage dashboard, not student-facing data), this is an
    // accepted, documented tradeoff rather than a silent gap — see the analytics section of
    // this project's most recent report for the full reasoning. Fully closing it requires
    // trusted server-side aggregation (Cloud Functions), which this project does not
    // currently use anywhere.
    match /analyticsDaily/{date} {
      allow read: if false;
      allow create, update: if isSignedIn() && isValidAnalyticsDailyDelta(analyticsAffectedKeys());
      allow delete: if false;
    }

    match /analyticsActivityDaily/{date} {
      allow read: if false;
      allow create, update: if isSignedIn() && isValidAnalyticsActivityDelta(analyticsAffectedKeys());
      allow delete: if false;
    }

    // Daily Active User marker — private, per-account, create-once. See
    // analyticsService.recordDailyActiveUser: a refresh, a second tab, logging out/in the
    // same day, or a second device all just retry this same already-exists create and are
    // safe no-ops, so dailyActiveUsers above can only ever count a given account once a day.
    match /analyticsDailyUsers/{date}/users/{uid} {
      // The owner may read only their own marker — needed so recordDailyActiveUser's
      // transaction can check "have I already been counted today" before writing, exactly
      // like the existing rewards ledger pattern above. Nobody else may ever read it.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Today's mood-check-in category marker — private, per-account. Lets
    // analyticsService.recordMoodCheckin tell "first check-in today" from "re-categorizing
    // today's check-in" apart, without ever exposing which student picked which mood.
    match /analyticsMoodDaily/{date}/users/{uid} {
      // The owner may read only their own marker — needed so recordMoodCheckin's
      // transaction can see today's already-recorded category (to tell a first check-in
      // from a same-day re-categorization) before writing.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.category is string;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.category is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'updatedAt']);
      allow delete: if false;
    }

    // Global, once-ever-per-account marker gating newUsers above — never on login, only the
    // account's own one-time onboarding completion (see AuthContext.completeOnboarding).
    match /analyticsNewUserMarkers/{uid} {
      // The owner may read only their own marker — needed so recordNewUser's transaction
      // can check "have I already been counted, ever" before writing.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // One marker per chat room session (never the deterministic pairId, so a later, genuine
    // new session between the same two people is still counted) gating chatSessionsStarted.
    // Tied to the exact same "I'm the receiver of a still-pending request" precondition
    // chatRooms' own create rule below already requires.
    match /analyticsChatStartMarkers/{roomId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.requestId is string
        && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.status == 'pending'
        && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.requestId)).data.toPublicId == myPublicId();
      allow update, delete: if false;
    }

    // One marker per room gating chatSessionsEnded — create-once, so even a retried
    // endConversation call (see its own already-ended no-op check) can't double count.
    match /analyticsChatEndMarkers/{roomId} {
      allow read: if false;
      allow create: if isSignedIn()
        && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
        && get(/databases/$(database)/documents/chatRooms/$(roomId)).data.status == 'active';
      allow update, delete: if false;
    }

    // Everything else is closed by default — no wildcard fallback rule.
  }
}
