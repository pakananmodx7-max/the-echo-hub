rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Resolves the caller's own publicId from their private user doc — never trusts a
    // client-supplied publicId for permission checks.
    function myPublicId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.publicId;
    }

    // Deterministic id for the (unordered) pair of two publicIds — used as the document
    // id for both a chat request and its resulting room, so there can only ever be one
    // live request/room between any two accounts at a time.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Private per-user document (codename, avatarId, mood, onboarding state, completed
    // activities, and the publicId pointer). Only the owning account may read or write
    // it. Email is intentionally never stored here — Firebase Auth already owns it — so
    // it can never leak through this collection even if a rule were misconfigured.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public-facing profile (codename, avatarId, mood only) keyed by a random publicId
    // that is NOT the Firebase uid — see users/{uid}.publicId. Any signed-in student may
    // read these (needed for Echo Space / online-members display); a profile may only be
    // written by the account whose private doc claims that publicId.
    match /publicProfiles/{publicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.publicId == publicId;
    }

    // A pending/accepted/declined/cancelled "may we chat privately" request between two
    // accounts, keyed by pairId(fromPublicId, toPublicId) so at most one live request can
    // exist between any two people. Sender/receiver codename+avatar+mood are denormalized
    // in at send-time purely for display — never the uid or email.
    match /chatRequests/{requestId} {
      allow read: if isSignedIn() && resource != null
        && (myPublicId() == resource.data.fromPublicId || myPublicId() == resource.data.toPublicId);

      // First-ever request between this pair.
      allow create: if isSignedIn()
        && request.resource.data.fromPublicId == myPublicId()
        && request.resource.data.toPublicId != myPublicId()
        && requestId == pairId(request.resource.data.fromPublicId, request.resource.data.toPublicId)
        && request.resource.data.status == 'pending'
        && request.resource.data.roomId == null;

      allow update: if isSignedIn() && (
        // Receiver accepts or declines a pending request.
        (myPublicId() == resource.data.toPublicId
          && resource.data.status == 'pending'
          && request.resource.data.fromPublicId == resource.data.fromPublicId
          && request.resource.data.toPublicId == resource.data.toPublicId
          && (
            (request.resource.data.status == 'declined' && request.resource.data.roomId == null)
            || (request.resource.data.status == 'accepted' && request.resource.data.roomId == requestId)
          ))
        ||
        // Sender cancels their own still-pending request.
        (myPublicId() == resource.data.fromPublicId
          && resource.data.status == 'pending'
          && request.resource.data.fromPublicId == resource.data.fromPublicId
          && request.resource.data.toPublicId == resource.data.toPublicId
          && request.resource.data.status == 'cancelled'
          && request.resource.data.roomId == null)
        ||
        // Either former party re-opens a finished request as a fresh pending one.
        (resource.data.status in ['declined', 'cancelled', 'expired']
          && (myPublicId() == resource.data.fromPublicId || myPublicId() == resource.data.toPublicId)
          && request.resource.data.fromPublicId == myPublicId()
          && request.resource.data.toPublicId != myPublicId()
          && (request.resource.data.toPublicId == resource.data.fromPublicId
              || request.resource.data.toPublicId == resource.data.toPublicId)
          && request.resource.data.status == 'pending'
          && request.resource.data.roomId == null)
      );

      allow delete: if false;
    }

    // A private 1:1 chat room, created only as part of the same write that accepts its
    // request (see acceptRequest in privateChatBridge.ts), keyed by the same pairId as
    // the request that created it. Only the two participants may ever read it or their
    // messages; nobody may write into a room they are not part of.
    match /chatRooms/{roomId} {
      allow read: if isSignedIn() && resource != null && myPublicId() in resource.data.participants;

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && myPublicId() in request.resource.data.participants
        && roomId == pairId(request.resource.data.participants[0], request.resource.data.participants[1])
        && request.resource.data.requestId == roomId
        && get(/databases/$(database)/documents/chatRequests/$(roomId)).data.status == 'pending'
        && get(/databases/$(database)/documents/chatRequests/$(roomId)).data.toPublicId == myPublicId();

      allow update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;

        allow create: if isSignedIn()
          && myPublicId() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && request.resource.data.senderPublicId == myPublicId()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    // Everything else is closed by default — no wildcard fallback rule.
  }
}
