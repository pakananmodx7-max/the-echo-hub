{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": "auth != null",
      "$publicId": {
        ".write": "auth != null && root.child('uidToPublicId').child(auth.uid).val() === $publicId"
      }
    },

    "uidToPublicId": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
